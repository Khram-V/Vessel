				<Linker>
					<Add library="Lib/libWindow32.a" />
					<Add library="opengl32" />
					<Add library="glu32" />
					<Add library="gdi32" />
				</Linker>
			</Target>
			<Target title="Qwen Ship">
				<Option output="../../Work/QWen" prefix_auto="1" extension_auto="1" />
				<Option working_dir="Data" />
				<Option object_output="../../Work/Obj" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectCompilerOptionsRelation="2" />
			</Target>
		</Build>
		<Compiler>
