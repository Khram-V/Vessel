<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Aurora on Stormy Waves" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Aurora">
				<Option platforms="Windows;" />
				<Option output="../../Aurora" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../Эскадра" />
				<Option object_output="../../Work/Obj" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option parameters='&quot;Крейсер Диана-Аврора.fef&quot; &quot;Galleon «Wasa»&quot; МегаЛоДон &quot;A-1204 Траулер-83&quot; &quot;A-1206 Cruise-1&quot; &quot;A-1205 75m&quot; &quot;A-1201 Корвет-Б(а)&quot; &quot;Free!Ship\F-1 Flatbottom drag racing&quot; «Аврора» &quot;Free!Ship\John Wilkins 50ft Cruising(c)&quot; &quot;Free!Ship\Jean-Marc NOURRY(28Pds)&quot; &quot;A-1203 Универсальное транспортное судно,1986&quot; &quot;1985 МИДВ(ординаты)&quot; &quot;Free!Ship\Pilot L16,5m-mod7&quot; &quot;Free!Ship\Китайский рыбак&quot; &quot;Free!Ship\Fregate type 23-11&quot; &quot;Free!Ship/Wolfson Twin keel yacht&quot; &quot;СРТМК «Василий Яковенко»-502ЭМ&quot; &quot;2006 Плавниковый подзор&quot; &quot;DTMB-5415 US Navy Combatant(keel)&quot; DD(X)-ONR5613  &quot;Эскадренный броненосец «Цесаревич»&quot; &quot;Г-5 Туполев&quot; &quot;A-1202 Морской спасатель - научно-исследовательское судно&quot; &quot;Крейсер «Рюрик»-II-1905&quot; &quot;EFF04 для Курил&quot; &quot;Крейсер «Варяг»-58&quot; &quot;Буксир «Арктикаборг»&quot; &quot;A-1200 Early&quot; Examples\Куб-5 &quot;БПК «Стерегущий»-61&quot; &quot;OSU Regional Class Research Vessel&quot; &quot;Буксир «Витязь»&quot; &quot;Речной теплоход «Родина» (Готман)&quot;' />
				<Compiler>
					<Add option="-fexpensive-optimizations" />
					<Add option="-O3" />
					<Add option="-ffunction-sections" />
					<Add option="-Wunused" />
				</Compiler>
				<Linker>
					<Add option="-O3" />
					<Add option="-s" />
					<Add option="--gc-sections" />
				</Linker>
			</Target>
			<Target title="Aurora-eq">
				<Option output="../../Work/Aurora-eq" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../Эскадра" />
				<Option object_output="../../Work/Obj" />
				<Option type="0" />
				<Option compiler="gcc-mingw64" />
				<Option parameters='«Аврора» &quot;Эскадренный броненосец «Цесаревич».vsl&quot;' />
				<Compiler>
					<Add option="-m64" />
					<Add option="-fopenmp" />
					<Add option="-funsigned-char" />
				</Compiler>
				<Linker>
					<Add option="-static-libstdc++" />
					<Add option="-static-libgcc" />
					<Add option="-static" />
					<Add option="-m64" />
				</Linker>
			</Target>
			<Target title="Aurora-stable">
				<Option output="../../Work/Aurora-stable" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../Эскадра" />
				<Option object_output="../../Work/Obj" />
				<Option type="0" />
				<Option compiler="gnu_gcc_stable" />
				<Option parameters='&quot;БПК «Стерегущий»-61&quot;' />
				<Compiler>
					<Add option="-m64" />
					<Add option="-Wno-narrowing" />
					<Add option="-Wno-literal-suffix" />
					<Add option="-Wno-volatile" />
					<Add option="-Wno-write-strings" />
				</Compiler>
				<Linker>
					<Add option="-static-libstdc++" />
					<Add option="-static-libgcc" />
					<Add option="-static" />
					<Add option="-m64" />
					<Add library="pthread" />
					<Add library="dl" />
				</Linker>
			</Target>
			<Target title="Aurora-night">
				<Option output="../../Work/Aurora-night" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../Эскадра" />
				<Option object_output="../../Work/Obj" />
				<Option type="0" />
				<Option compiler="gnu_gcc_nightly" />
				<Option parameters='&quot;OSU Regional Class Research Vessel.vsl&quot;' />
				<Compiler>
					<Add option="-Wno-narrowing" />
					<Add option="-Wno-volatile" />
				</Compiler>
				<Linker>
					<Add library="pthread" />
					<Add library="dl" />
				</Linker>
			</Target>
			<Target title="Waves Profile">
				<Option output="../../Work/Wave" prefix_auto="1" extension_auto="1" />
				<Option working_dir="Data" />
				<Option object_output="../../Work/Obj" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectCompilerOptionsRelation="0" />
			</Target>
			<Target title="Qwen Waves">
				<Option output="../../Work/QWen" prefix_auto="1" extension_auto="1" />
